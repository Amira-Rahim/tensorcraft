{
  "$schema": "https://v2-10-5.turborepo.dev/schema.json",
  "tasks": {
    "build:content": {
      "outputs": [".velite/**"],
      "inputs": ["content/**", "velite.config.ts"]
    },
    "build": {
      "dependsOn": ["^build", "build:content"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build", "build:content"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
