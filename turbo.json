{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "tasks": {
    "build:content": {
      "outputs": [".velite/**"],
      "inputs": [
        "content/**",
        "src/**",
        "velite.config.ts",
        "package.json",
        "$TURBO_ROOT$/packages/shared/src/scan-stops.ts"
      ]
    },
    "build": {
      "dependsOn": ["^build", "build:content"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"]
    },
    "dev": {
      "dependsOn": ["^build", "build:content"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
