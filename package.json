{
  "name": "tensorcraft",
  "private": true,
  "license": "MPL-2.0",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "turbo dev",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:rls": "node scripts/test-rls.mjs",
    "review:prepare": "node scripts/review.mjs prepare",
    "review:dev": "node scripts/review.mjs dev",
    "review:stop": "node scripts/review.mjs stop",
    "review:check": "node --test scripts/review.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "RUN_VISUAL=1 playwright test e2e/visual --project=chromium --update-snapshots=none",
    "test:visual:update": "RUN_VISUAL=1 playwright test e2e/visual --project=chromium --update-snapshots=all",
    "test:exercises": "pnpm turbo build:content && node scripts/validate-exercises.mjs --starters --cheats",
    "gen:types": "node scripts/gen-supabase-types.mjs",
    "migrate:status": "node scripts/migration-status.mjs",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@axe-core/playwright": "^4.14.0",
    "@huggingface/transformers": "4.3.1",
    "@playwright/test": "^1.64.1",
    "@supabase/postgres-meta": "^0.100.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "4.22.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "onnx-proto": "8.0.1",
    "onnxruntime-web": "1.30.0",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "turbo": "^2.11.10",
    "vite": "^7.3.6",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,js,mjs}": [
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "ws@8": "^8.21.0",
      "ws@7": "^7.5.11",
      "picomatch@4": "^4.0.4",
      "picomatch@2": "^2.3.2",
      "form-data@4": "^4.0.6",
      "brace-expansion@5": "^5.0.9",
      "brace-expansion@1": "^1.1.16",
      "postcss@8": "^8.5.23",
      "fast-uri@3": "^3.1.9",
      "nanoid@3": "^3.3.18",
      "dompurify@3": "^3.4.17",
      "@opentelemetry/core@2": "^2.8.0",
      "@babel/core@7": "^7.29.6",
      "uuid@10": "^11.1.1",
      "esbuild@<0.28.1": "^0.28.1",
      "flatted@3": "^3.4.2",
      "js-yaml@4": "^4.3.0",
      "lodash-es@4": "^4.18.1",
      "undici@7": "^7.28.0",
      "vite": "^7.3.7",
      "yaml@2": "^2.8.3",
      "@anthropic-ai/sdk@<0.91.1": "^0.91.1",
      "sharp": "^0.35.5",
      "browserslist@4": "^4.28.7",
      "source-map-js@1": "^1.2.2",
      "fast-copy@4": "^4.1.0"
    }
  }
}
