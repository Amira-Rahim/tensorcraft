# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe
# Price IDs are NOT used — checkout sessions build line_items inline via
# `price_data` in apps/api/src/routes/payments.ts using amounts from
# packages/shared/src/constants.ts (PRICING). No STRIPE_PRICE_* env vars needed.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Server
PORT=3001

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,https://tensorcraft.app,https://www.tensorcraft.app

# Redis (REQUIRED — mandatory for rate limiting + JWT cache)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Admin API key (required for admin endpoints when not using role-based auth)
ADMIN_API_KEY=

# Frontend URL (used for Stripe checkout redirect)
APP_URL=http://localhost:3000

# GitHub App (for exercise solution push integration — tech-spec 5.1)
#
# Create a GitHub App at https://github.com/settings/apps/new with:
#   Permissions: contents: write, metadata: read
#   Callback URL: {APP_URL}/api/github/callback (or override via GITHUB_CALLBACK_URL)
#   Request user authorization during installation: enabled
#
# After creation, generate a private key (.pem) and paste it into GITHUB_APP_PRIVATE_KEY.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional — overrides the default callback URL ({APP_URL}/api/github/callback).
GITHUB_CALLBACK_URL=

# Kit (ConvertKit) email integration
KIT_API_KEY=
KIT_API_SECRET=
KIT_FORM_ID=

# Kit lifecycle tags (numeric IDs from the Kit dashboard — each triggers the
# Kit sequence that sends the corresponding template per docs/email-templates.md).
# Missing tag IDs are silently skipped by the API (see email-tags.ts) — production
# deploy must set every one. `KIT_TAG_PURCHASED` is theme-agnostic in V1; see
# dev-plan.md §10e for the per-theme deferral note.
KIT_TAG_SIGNED_UP=
KIT_TAG_ONBOARDED=
KIT_TAG_FIRST_LESSON=
KIT_TAG_CAPSTONE=
KIT_TAG_PURCHASED=
KIT_TAG_EMAIL_ALERTS=
KIT_TAG_WEEKLY_DIGEST=

# Shared secret validating Kit → /api/webhooks/kit-bounce POSTs. Generate with
# `openssl rand -hex 32`. Unset = the route returns 503 (fail-closed); see
# apps/api/src/routes/webhooks.ts + docs/email-setup.md §3.
KIT_WEBHOOK_SECRET=

# Resend (issue report email notifications)
RESEND_API_KEY=re_...
SUPPORT_EMAIL=support@tensorcraft.app

# Certificate signing — deterministic SHA-256 salt used by
# /api/certificates to produce `cert_hash` = sha256(user:theme:issued_at:secret).
# Rotating this value invalidates every previously-issued certificate hash,
# so treat it like a secret. Generate with: openssl rand -hex 32
CERT_SIGNING_SECRET=

# Sentry error tracking (optional — leave blank to disable)
SENTRY_DSN=

# PostHog server-side analytics — EU instance (GDPR data residency).
# Required only if the API emits conversion events (purchase_completed, etc.).
POSTHOG_KEY=
POSTHOG_HOST=https://eu.posthog.com
