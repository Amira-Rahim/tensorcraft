# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Server
PORT=3001

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,https://tensorcraft.dev,https://www.tensorcraft.dev

# Redis (REQUIRED — mandatory for rate limiting + JWT cache)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Admin API key (required for admin endpoints when not using role-based auth)
ADMIN_API_KEY=

# Frontend URL (used for Stripe checkout redirect)
APP_URL=http://localhost:3000

# GitHub App (for exercise solution push integration)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Kit (ConvertKit) email integration
KIT_API_KEY=
KIT_API_SECRET=
KIT_FORM_ID=

# Kit purchase tag (numeric ID from Kit dashboard — triggers confirmation email)
KIT_TAG_PURCHASED_DEEP_ORBIT=

# Resend (issue report email notifications)
RESEND_API_KEY=re_...
SUPPORT_EMAIL=support@tensorcraft.dev
