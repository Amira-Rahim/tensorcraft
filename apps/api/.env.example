# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe
# Price IDs are NOT used - checkout sessions build line_items inline via
# `price_data` in apps/api/src/routes/payments.ts using amounts from
# packages/shared/src/constants.ts (PRICING). No STRIPE_PRICE_* env vars needed.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Tax master switch (R3-3). "true" adds automatic_tax +
# billing_address_collection + tax_id_collection + invoice_creation to every
# Checkout Session. PREREQUISITES before flipping: Stripe Tax activated in
# the dashboard AND migration 047 applied (the webhook persists the captured
# jurisdiction). Unset/anything else = flat untaxed USD charges (the R2-4
# legal exposure persists while this is off).
STRIPE_TAX_ENABLED=

# Server
PORT=3001

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,https://tensorcraft.app,https://www.tensorcraft.app

# Redis (REQUIRED - mandatory for rate limiting + JWT cache)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Admin API key (required for admin endpoints when not using role-based auth)
ADMIN_API_KEY=

# Frontend URL (used for Stripe checkout redirect)
APP_URL=http://localhost:3000

# GitHub OAuth (exercise solution push - tech-spec 5.1)
#
# NOTE (2026-07-25, R3-10): the GitHub APP vars (GITHUB_APP_ID /
# GITHUB_APP_PRIVATE_KEY / GITHUB_PRIVATE_KEY) were REMOVED - no code has
# read them since the unused packages/github client was deleted. Provisioning
# them does nothing. The live integration is OAuth-only:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional - overrides the default callback URL ({APP_URL}/api/github/callback).
GITHUB_CALLBACK_URL=

# Kit (ConvertKit) email integration
KIT_API_KEY=
KIT_API_SECRET=
KIT_FORM_ID=

# Kit lifecycle tags (numeric IDs from the Kit dashboard - each triggers the
# Kit sequence that sends the corresponding template per docs/email-templates.md).
# Missing tag IDs are silently skipped by the API (see email-tags.ts) - production
# deploy must set every one. `KIT_TAG_PURCHASED` is world-agnostic in V1; see
# docs/post-launch-backlog.md for deferred per-world purchase sequences.
KIT_TAG_SIGNED_UP=
KIT_TAG_ONBOARDED=
KIT_TAG_FIRST_LESSON=
KIT_TAG_CAPSTONE=
KIT_TAG_PURCHASED=
KIT_TAG_EMAIL_ALERTS=
KIT_TAG_WEEKLY_DIGEST=
# Behavioral tags (R2-7): unset, /api/email answers 200 {skipped:true} and
# the client keeps retrying on later visits - recoverable, but sequences
# keyed to these tags cannot fire until the ids exist.
KIT_TAG_PAYWALL_HIT=
KIT_TAG_MODULE_1_COMPLETE=

# Shared secret validating Kit → /api/webhooks/kit-bounce POSTs. Generate with
# `openssl rand -hex 32`. Unset = the route returns 503 (fail-closed); see
# apps/api/src/routes/webhooks.ts + docs/email-setup.md §3.
KIT_WEBHOOK_SECRET=

# Resend (issue report email notifications)
RESEND_API_KEY=re_...
SUPPORT_EMAIL=support@tensorcraft.app

# Certificate signing - deterministic SHA-256 salt used by
# /api/certificates to produce `cert_hash` = sha256(user:world:issued_at:secret).
# Rotating this value invalidates every previously-issued certificate hash,
# so treat it like a secret. Generate with: openssl rand -hex 32
CERT_SIGNING_SECRET=

# Sentry error tracking (optional - leave blank to disable)
SENTRY_DSN=

# PostHog server-side analytics - EU instance (GDPR data residency).
# Required for server conversion events (payment_completed, etc.).
# Copy the project token and ingestion host from the connected project settings.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=

# Encryption key for profiles.github_token (AES-256-GCM at rest).
# Any sufficiently long random string; it is hashed to a 32-byte key, so you
# do not need to get base64 lengths right. Generate with:
#   openssl rand -base64 48
# Required in production since 2026-09-20 (deploy preflight fails without
# it): the browser OAuth callback hard-fails when it cannot seal the rotating
# token pair. Locally, UNSET means tokens are stored in PLAINTEXT, with a
# warning on every boot. Rows already written stay readable either way: the stored value
# is self-identifying, so legacy plaintext keeps working after you set this.
# WARNING: changing or losing this key makes existing encrypted tokens
# unreadable. Affected users are treated as disconnected and must reconnect
# GitHub, which is recoverable but visible to them.
GITHUB_TOKEN_ENC_KEY=

# Where operator alerts go: purchases, refunds, chargebacks (docs/observability.md).
# Falls back to SUPPORT_EMAIL when unset. Unset RESEND_API_KEY disables them
# entirely, with a warning at boot rather than silence.
OPERATOR_ALERT_EMAIL=
