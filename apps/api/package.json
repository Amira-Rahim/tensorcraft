    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.38.4",
    "hono": "^4.13.8",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "posthog-node": "^5.52.5",
    "resend": "^6.28.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@tensorcraft/config": "workspace:*",
    "@types/node": "^22.0.0",
