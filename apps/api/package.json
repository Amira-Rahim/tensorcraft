    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "posthog-node": "^5.55.2",
    "resend": "^6.32.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@tensorcraft/config": "workspace:*",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
