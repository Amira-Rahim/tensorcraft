    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "hono": "^4.12.34",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "posthog-node": "^5.29.2",
    "resend": "^6.9.4",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@tensorcraft/config": "workspace:*",
