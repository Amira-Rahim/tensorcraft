# Supabase (required — get from https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# PostHog analytics — EU instance (GDPR data residency). Leave key blank to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Sentry error tracking (optional — leave blank to disable in dev/preview)
NEXT_PUBLIC_SENTRY_DSN=

# API URL (Fly.io in production; required in production, boot assertion enforces it)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-side Supabase admin (required in PRODUCTION: the RFC 8058 one-click
# unsubscribe route needs the admin client; unset on Vercel it throws per
# provider POST and Gmail/Yahoo bulk rules treat that as broken one-click)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Sentry source-map upload at build time (optional; unset means production
# stack traces stay minified in Sentry)
SENTRY_AUTH_TOKEN=

# Plausible analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tensorcraft.app
