// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Privacy page snapshots > matches snapshot 1`] = `
<main
  class="min-h-screen px-6 py-24 relative"
>
  <div
    class="absolute inset-0 grid-bg pointer-events-none z-0"
  />
  <article
    class="max-w-[720px] mx-auto relative z-10"
  >
    <a
      class="text-sm text-text-muted hover:text-text-primary transition-colors mb-12 inline-block"
      href="/"
    >
      ← Back to home
    </a>
    <h1
      class="text-4xl font-bold mb-2"
    >
      Privacy Policy
    </h1>
    <p
      class="text-text-muted mb-12"
    >
      Last updated: April 21, 2026
    </p>
    <div
      class="space-y-8 text-[15px] leading-relaxed text-text-muted"
    >
      <section>
        <h2
          class="text-xl font-semibold text-text-primary mb-3"
        >
          1. Information We Collect
        </h2>
        <p
          class="mb-3"
        >
          <strong
            class="text-text-primary"
          >
            Account data:
          </strong>
           When you create an account, we collect your email address, display name, and avatar URL from your authentication provider (GitHub or Google).
        </p>
        <p
          class="mb-3"
        >
          <strong
            class="text-text-primary"
          >
            Usage data:
          </strong>
           We collect information about your learning progress, including lessons completed, exercise scores, and hints used.
        </p>
        <p>
          <strong
            class="text-text-primary"
          >
            Analytics data:
          </strong>
           
          When configured, we use privacy-focused analytics tools (PostHog and Plausible) to understand how the platform is used. These services are only active when explicitly enabled by our team. We do not sell your data to third parties.
        </p>
      </section>
      <section>
        <h2
          class="text-xl font-semibold text-text-primary mb-3"
        >
          2. How We Use Your Information
        </h2>
        <p>
          We use your information to: (a) provide and improve the Service; (b) track your learning progress; (c) process payments; (d) send transactional emails (account verification, purchase receipts); (e) analyze platform usage to improve the learning experience.
        </p>
      </section>
      <section>
        <h2
          class="text-xl font-semibold text-text-primary mb-3"
        >
          3. Data Storage & Security
        </h2>
        <p>
          Your data is stored in Supabase (PostgreSQL) with row-level security policies. Authentication tokens are handled securely via industry-standard OAuth 2.0 / PKCE flows. All data transmission uses TLS encryption.
        </p>
      </section>
      <section>
        <h2
          class="text-xl font-semibold text-text-primary mb-3"
        >
          4. Third-Party Services
        </h2>
        <p>
          We use the following third-party services:
        </p>
        <ul
          class="list-disc pl-6 mt-2 space-y-1"
        >
          <li>
            <strong
              class="text-text-primary"
            >
              Supabase
            </strong>
            : Authentication and database
          </li>
          <li>
            <strong
              class="text-text-primary"
            >
              Stripe
            </strong>
            : Payment processing
          </li>
          <li>
            <strong
              class="text-text-primary"
            >
              Kit (ConvertKit)
            </strong>
            : Transactional and lifecycle email delivery
          </li>
          <li>
            <strong
              class="text-text-primary"
            >
              Sentry
            </strong>
            : Error monitoring via DSN; captures errors and stack traces. PII (emails, user IDs) is scrubbed via a
             
            <code
              class="font-mono text-text-primary"
            >
              beforeSend
            </code>
             
            hook before transmission.
          </li>
          <li>
            <strong
              class="text-text-primary"
            >
              PostHog
            </strong>
            : Product analytics on the EU instance (
            <code
              class="font-mono text-text-primary"
            >
              eu.posthog.com
            </code>
            ) for GDPR-compliant data residency. Cookie-consent-gated.
          </li>
          <li>
            <strong
              class="text-text-primary"
            >
              Plausible
            </strong>
            : Privacy-first pageview analytics. Cookie-free and EU-hosted.
          </li>
          <li>
            <strong
              class="text-text-primary"
            >
              Vercel
            </strong>
            : Web hosting and deployment
          </li>
          <li>
            <strong
              class="text-text-primary"
            >
              Fly.io
            </strong>
            : API hosting
          </li>
          <li>
            <strong
              class="text-text-primary"
            >
              GitHub App
            </strong>
            : Optional user integration for exercise push flow (only when explicitly authorized by you)
          </li>
        </ul>
      </section>
      <section>
        <h2
          class="text-xl font-semibold text-text-primary mb-3"
        >
          5. Cookies
        </h2>
        <p>
          We use essential cookies for authentication session management. When PostHog analytics is active, analytics cookies are only set with your explicit consent via our cookie banner. Plausible does not use cookies.
        </p>
      </section>
      <section>
        <h2
          class="text-xl font-semibold text-text-primary mb-3"
        >
          6. Your Rights (GDPR / CCPA)
        </h2>
        <p>
          You have the right to:
        </p>
        <ul
          class="list-disc pl-6 mt-2 space-y-1"
        >
          <li>
            Access and export your personal data
          </li>
          <li>
            Request correction of inaccurate data
          </li>
          <li>
            Request deletion of your account and data
          </li>
          <li>
            Opt out of non-essential analytics
          </li>
          <li>
            Withdraw consent at any time
          </li>
        </ul>
        <p
          class="mt-3"
        >
          To exercise these rights, email
           
          <a
            class="text-accent hover:underline"
            href="mailto:privacy@tensorcraft.app"
          >
            privacy@tensorcraft.app
          </a>
          .
        </p>
      </section>
      <section>
        <h2
          class="text-xl font-semibold text-text-primary mb-3"
        >
          7. Data Retention
        </h2>
        <p>
          We retain your account data and learning progress for as long as your account is active. If you delete your account, we will remove your personal data within 30 days. Anonymized analytics data may be retained indefinitely.
        </p>
      </section>
      <section>
        <h2
          class="text-xl font-semibold text-text-primary mb-3"
        >
          8. Children's Privacy
        </h2>
        <p>
          Tensorcraft is not intended for users under the age of 16. We do not knowingly collect personal information from children.
        </p>
      </section>
      <section>
        <h2
          class="text-xl font-semibold text-text-primary mb-3"
        >
          9. Changes to This Policy
        </h2>
        <p>
          We may update this privacy policy from time to time. We will notify you of significant changes via email. The "Last updated" date at the top reflects the most recent revision.
        </p>
      </section>
      <section>
        <h2
          class="text-xl font-semibold text-text-primary mb-3"
        >
          10. Contact
        </h2>
        <p>
          Questions about privacy? Contact our data protection team at
           
          <a
            class="text-accent hover:underline"
            href="mailto:privacy@tensorcraft.app"
          >
            privacy@tensorcraft.app
          </a>
          .
        </p>
      </section>
    </div>
  </article>
</main>
`;
